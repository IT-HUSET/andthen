      "category": "pipe_to_shell"
    },
    {
      "regex": "\\b(bash|sh|zsh|dash|ksh)\\s+-c\\b",
      "message": "Shell interpreter escape blocked. Run the command directly.",
      "category": "interpreter_escape"
    },
    {
      "regex": "\\beval\\s+[\"']",
      "message": "eval blocked. Run the command directly.",
      "category": "interpreter_escape"
    },
    {
