{
  "plansDirectory": "docs/temp/plans",
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.envrc)",
      "Read(./*.pem)",
      "Read(./*.key)",
      "Read(./*.p12)",
      "Read(./*.pfx)",
      "Read(./id_rsa*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git rebase *)",
      "Bash(git revert *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete*)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git tag -d *)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git checkout -B *)",
      "Bash(git checkout -f *)",
      "Bash(git checkout --force*)",
      "Bash(git checkout --orphan *)",
      "Bash(git commit --amend*)",
      "Bash(git restore *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh release create *)"
    ],
    "allow": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/hooks/scripts/block-dangerous-commands.py",
            "timeout": 15,
            "statusMessage": "Checking for dangerous commands..."
          }
        ]
      }
    ]
  }
}
