{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "andthen:architecture-model.schema.json",
  "title": "AndThen architecture model",
  "description": "Machine form of architecture-model.md beside it. Carries every invariant JSON Schema can state; id uniqueness, reference resolution, and the ref rule are stated by that reference and are the producer's to check.",
  "type": "object",
  "required": ["schemaVersion", "kind", "meta", "contexts", "nodes", "edges"],
  "properties": {
    "schemaVersion": {
      "description": "Consumers reject unknown versions rather than best-effort rendering.",
      "const": "1"
    },
    "kind": {
      "description": "The discriminator consumers key on before inspecting anything else.",
      "const": "architecture-model"
    },
    "meta": {
      "type": "object",
      "required": ["project", "generatedBy", "date", "revision"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "generatedBy": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "revision": {
          "type": "string",
          "minLength": 1,
          "description": "Git short SHA of the source's last commit, suffixed -dirty when the working tree differs - what a reader diffs the source against."
        },
        "summary": { "type": "string" }
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "summary", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["bounded-context", "layer", "subsystem", "external"] },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "enum": ["declared", "inferred"] }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "contextId", "kind", "ref"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "contextId": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["module", "package", "service", "component", "store", "entrypoint", "external"] },
          "ref": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "files": { "$ref": "#/$defs/count" },
              "loc": { "$ref": "#/$defs/count" },
              "churn": { "$ref": "#/$defs/count" },
              "fanIn": { "$ref": "#/$defs/count" },
              "fanOut": { "$ref": "#/$defs/count" }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind", "evidence"],
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["depends", "calls", "publishes", "consumes", "reads", "writes"] },
          "label": { "type": "string" },
          "weight": { "type": "integer", "minimum": 1 },
          "evidence": { "enum": ["imports", "declared", "git-coupling", "inferred"] }
        }
      }
    },
    "tours": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "steps"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["note"],
              "properties": {
                "note": { "type": "string", "minLength": 1 },
                "nodeId": { "type": ["string", "null"] },
                "contextId": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 0 }
  }
}
